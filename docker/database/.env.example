# Biến cho docker/database/docker-compose.yml (môi trường dev).
#
# Bắt buộc: POSTGRES_PASSWORD không còn giá trị mặc định trong compose.
# Tạo file .env cạnh compose rồi đặt mật khẩu mạnh:
#
#   cp docker/database/.env.example docker/database/.env
#   openssl rand -hex 16   # dán kết quả vào POSTGRES_PASSWORD
#
POSTGRES_USER=bistro
POSTGRES_PASSWORD=
POSTGRES_DB=bistro
